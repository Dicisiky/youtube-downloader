# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
.next/
*.tsbuildinfo

# --- Env / secrets (never commit real values -- .env.example / .env.local.example ARE tracked) ---
.env
.env.*
!.env.example
!.env.*.example

# --- Recordings (large binaries; keep the folder via .gitkeep, not its contents) ---
storage/recordings/*
!storage/recordings/.gitkeep

# --- yt-dlp cookies (real YouTube session credentials, never commit) ---
secrets/

# --- Logs ---
*.log
npm-debug.log*

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Claude Code runtime state (not app content) ---
.claude/
