# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yt_livestream?schema=public"

# --- Server ---
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Server-side API key (no OAuth needed) used to poll public live status /
# resolve channel URLs -> channelId for MONITORED (source) channels.
# Create under APIs & Services -> Credentials -> API key, restrict to YouTube Data API v3.
YOUTUBE_API_KEY="your-api-key"

# --- Google / YouTube OAuth2 ---
# Create these in Google Cloud Console -> APIs & Services -> Credentials
# (OAuth client type: Web application). Enable "YouTube Data API v3".
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/youtube/callback"

# --- App login (Google "Sign in with Google") ---
# Separate OAuth flow from the upload-destination one above -- this is for
# accessing the dashboard itself. Reuses the SAME GOOGLE_CLIENT_ID/SECRET, but
# needs its OWN redirect URI added to the OAuth client's authorized redirect
# URIs list in Google Cloud Console.
GOOGLE_LOGIN_REDIRECT_URI="http://localhost:4000/auth/google/callback"
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# The Google account email that is auto-approved as admin on first login and
# can approve/reject every other pending account. Must match exactly.
ADMIN_EMAIL="you@example.com"

# --- yt-dlp ---
# Full path to yt-dlp.exe on the Windows host. Use forward slashes even on
# Windows (e.g. C:/tools/yt-dlp/yt-dlp.exe) -- dotenv interprets backslash
# escapes inside double-quoted values (\r, \n, \t), so "C:\\tools\\..." can
# silently corrupt into a path containing a literal carriage-return character.
YTDLP_PATH="yt-dlp.exe"
# Full path to ffmpeg.exe (yt-dlp needs it to remux/merge streams)
FFMPEG_PATH="ffmpeg.exe"
# Directory where in-progress and finished recordings are stored
RECORDINGS_DIR="E:/youtube-downloader/storage/recordings"
# Optional. Path to a Netscape-format cookies.txt exported from a real,
# logged-in YouTube browser session (e.g. via the "Get cookies.txt LOCALLY"
# extension). Usually unnecessary on a home connection, but cloud/VPS IPs get
# challenged by YouTube with "Sign in to confirm you're not a bot" -- passing
# cookies from an authenticated session works around that. Leave unset to
# disable.
YTDLP_COOKIES_FILE=""

# --- Polling ---
# How often (ms) the monitor loop checks each whitelisted channel's live status
POLL_INTERVAL_MS=60000
